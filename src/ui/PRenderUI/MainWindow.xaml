<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PRenderUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="PRender">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="16,10,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F8;" FontSize="18" />
                <TextBlock Text="PRender" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="spectral · unbiased · Metropolis light transport" VerticalAlignment="Bottom" Margin="0,0,0,3"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <TextBlock x:Name="ScenePathText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="SceneBox" MinWidth="220" PlaceholderText="Scene" VerticalAlignment="Center"
                          SelectionChanged="OnSceneSelected" DropDownOpened="OnSceneDropDownOpened"
                          ToolTipService.ToolTip="Scenes in the folder above the current scene's folder (rescanned when opened)" />
                <Button x:Name="OpenButton" Click="OnOpenClick" ToolTipService.ToolTip="Open a .prscene.json scene">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open scene" />
                    </StackPanel>
                </Button>
                <Button x:Name="ReloadButton" Click="OnReloadClick" ToolTipService.ToolTip="Reload the scene from disk">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- Four views -->
            <Grid x:Name="ViewGrid" RowSpacing="6" ColumnSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource ViewportBackground}" BorderBrush="{StaticResource ViewportBorder}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <canvas:CanvasControl x:Name="TopCanvas" ClearColor="#FF1B1D21" />
                        <TextBlock x:Name="TopLabel" Margin="10,6" Foreground="{StaticResource ViewportLabel}" FontSize="12" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource ViewportBackground}" BorderBrush="{StaticResource ViewportBorder}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <canvas:CanvasControl x:Name="CameraCanvas" ClearColor="#FF15171A" />
                        <TextBlock Text="Camera  ·  drag to orbit, right-drag to pan, wheel to dolly" Margin="10,6"
                                   Foreground="{StaticResource ViewportLabel}" FontSize="12" IsHitTestVisible="False" />
                        <Button x:Name="ResetCameraButton" Click="OnResetCameraClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="6" Padding="8,3" FontSize="12" Visibility="Collapsed" Content="Reset camera" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ViewportBackground}" BorderBrush="{StaticResource ViewportBorder}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <canvas:CanvasControl x:Name="FrontCanvas" ClearColor="#FF1B1D21" />
                        <TextBlock x:Name="FrontLabel" Margin="10,6" Foreground="{StaticResource ViewportLabel}" FontSize="12" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ViewportBackground}" BorderBrush="{StaticResource ViewportBorder}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <canvas:CanvasControl x:Name="RightCanvas" ClearColor="#FF1B1D21" />
                        <TextBlock x:Name="RightLabel" Margin="10,6" Foreground="{StaticResource ViewportLabel}" FontSize="12" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Render panel -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ScrollViewer Padding="16,12,16,12">
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />

                        <TextBlock Text="Render" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="CameraBox" Header="Camera" HorizontalAlignment="Stretch" SelectionChanged="OnCameraChanged" />
                            <ComboBox x:Name="IntegratorBox" Grid.Column="1" Header="Integrator" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnIntegratorChanged">
                                <ComboBoxItem Content="MMLT" Tag="mmlt" ToolTipService.ToolTip="Multiplexed Metropolis light transport (default)" />
                                <ComboBoxItem Content="PSSMLT" Tag="pssmlt" ToolTipService.ToolTip="Kelemen primary-sample-space MLT over full BDPT" />
                                <ComboBoxItem Content="BDPT" Tag="bdpt" ToolTipService.ToolTip="Bidirectional path tracing" />
                                <ComboBoxItem Content="Path tracer" Tag="path" ToolTipService.ToolTip="Unidirectional volumetric path tracer (reference)" />
                            </ComboBox>
                            <ComboBox x:Name="ResolutionBox" Grid.Row="1" Header="Resolution" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnResolutionChanged" />
                            <NumberBox x:Name="SamplesBox" Grid.Row="1" Grid.Column="1" Header="Mutations / pixel" Minimum="1" Maximum="1000000"
                                       SpinButtonPlacementMode="Compact" SmallChange="64" LargeChange="256" />
                            <NumberBox x:Name="TimeBox" Grid.Row="2" Header="Time limit (s, 0 = none)" Minimum="0" Maximum="86400"
                                       SpinButtonPlacementMode="Compact" SmallChange="10" LargeChange="60" Value="0" />
                            <NumberBox x:Name="SeedBox" Grid.Row="2" Grid.Column="1" Header="Seed" Minimum="0" Maximum="2147483647"
                                       SpinButtonPlacementMode="Compact" Value="1" />
                            <NumberBox x:Name="MaxDepthBox" Grid.Row="3" Header="Max depth (0 = default)" Minimum="0" Maximum="4096"
                                       SpinButtonPlacementMode="Compact" SmallChange="8" LargeChange="32" Value="0"
                                       ToolTipService.ToolTip="Longest light path in bounces. MLT and BDPT never sample longer paths, so use 64+ for heavy subsurface scattering. 0 = integrator default: 32 for MLT, 256 for BDPT, unlimited (Russian roulette) for the path tracer." />
                            <ComboBox x:Name="DeviceBox" Grid.Row="4" Grid.ColumnSpan="2" Header="Device" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnDeviceChanged"
                                      ToolTipService.ToolTip="GPU rendering (oneAPI/SYCL) supports the path tracer; other integrators run on the CPU" />
                        </Grid>
                        <TextBlock x:Name="ResolutionInfo" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Light rigs" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="RigPanel" Orientation="Horizontal" Spacing="12" />
                        </StackPanel>

                        <CheckBox x:Name="AovCheck" Content="Also write AOVs (albedo, normal, depth)" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DenoiseCheck" Content="Denoise" VerticalAlignment="Bottom"
                                      ToolTipService.ToolTip="Also write a denoised image (Intel Open Image Denoise). Denoising is biased: it removes noise but can shift colours slightly, so the unbiased render is always kept too." />
                            <NumberBox x:Name="ClampBox" Grid.Column="1" Header="Firefly clamp (0 = off)" Minimum="0" Maximum="1000000"
                                       SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="10" Value="0"
                                       ToolTipService.ToolTip="Limit each sample's luminance to this value (path tracer and BDPT). Removes fireflies but also real energy (biased). Try 5–50 for this scene; 0 turns it off." />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RenderButton" Click="OnRenderClick" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Height="40">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="RenderIcon" Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock x:Name="RenderButtonText" Text="Render" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ContinueButton" Grid.Column="1" Click="OnContinueClick" Height="40" IsEnabled="False"
                                    ToolTipService.ToolTip="Resume the last render from its checkpoint with twice the samples">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                                    <TextBlock Text="Continue" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="4">
                            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="StatsText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Background="#FF101114" CornerRadius="6" MinHeight="200" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="ImagePlaceholder" Text="The render appears here" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#FF7A808A" />
                                <Image x:Name="RenderImage" Stretch="Uniform" Tapped="OnImageTapped"
                                       ToolTipService.ToolTip="Click to open the full-size image" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenFolderButton" Click="OnOpenFolderClick" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="Output folder" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenImageButton" Click="OnImageTapped" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="Open image" />
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="DenoisedToggle" Content="Denoised" IsEnabled="False" Click="OnDenoisedToggle"
                                          ToolTipService.ToolTip="Switch between the denoised and the unbiased (raw) image" />
                        </StackPanel>

                        <Expander Header="Renderer log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="180"
                                     FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="16,4,16,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HoverText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="RendererText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
        </Grid>
    </Grid>
</Window>
