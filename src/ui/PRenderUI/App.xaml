<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PRenderUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Viewports stay dark in both themes, as is conventional for 3D views. -->
            <SolidColorBrush x:Key="ViewportBackground" Color="#FF1B1D21" />
            <SolidColorBrush x:Key="ViewportBorder" Color="#FF30343B" />
            <SolidColorBrush x:Key="ViewportLabel" Color="#FFB8C0CC" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
